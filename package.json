{
  "name": "mra-resume-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "deploy": "npm run build && npm run push",
    "push": "git add . && git commit -m 'Deploy updates' && git push origin master",
    "serve": "vite preview --port 4173"
  },
  "dependencies": {
    "vue": "^3.4.29",
    "vue-router": "^4.2.4",
    "pinia": "^2.1.6",
    "vuedraggable": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-vue-next": "^0.284.0",
    "vue-toastification": "^2.0.0-rc.5",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0",
    "tailwindcss": "^3.3.3",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "vue-color-kit": "^1.0.5",
    "file-saver": "^2.0.5",
    "mammoth": "^1.6.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.3.1",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.29",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.1",
    "prettier": "^3.0.0"
  }
}
